# Copia a .env y rellena
DB_PASSWORD=cambia-esto

# Enable Banking: ID de la aplicación (Control Panel) y clave privada en ./secrets/eb_private_key.pem
EB_APPLICATION_ID=

# Debe coincidir con la redirect URL registrada en Enable Banking: ${PUBLIC_URL}/api/banks/callback
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
EB_COUNTRY=ES
