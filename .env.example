# Copy to .env and fill in
DB_PASSWORD=change-me

# Required outside Docker Compose (which builds it from DB_PASSWORD), e.g. for local runs
# DATABASE_URL=postgresql+psycopg://cheles:<DB_PASSWORD>@localhost:5432/cheles

# Enable Banking: application ID (Control Panel); the private key lives in ./secrets/eb_private_key.pem
EB_APPLICATION_ID=

# Must match the redirect URL registered in Enable Banking: ${PUBLIC_URL}/api/banks/callback
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
EB_COUNTRY=ES
